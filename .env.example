APP_NAME=customer-intelligence-platform
APP_ENV=development
LOG_LEVEL=INFO

SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CUSTOMER_INTELLIGENCE
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_INSECURE_MODE=false

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_AUTH_ENABLED=false
API_KEY=
API_RATE_LIMIT_PER_MINUTE=60
MODEL_PATH=ml/artifacts/random_forest_reorder_model.joblib

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=instacart.orders
KAFKA_CONSUMER_GROUP=customer-intelligence-streaming
KAFKA_BATCH_SIZE=100
